# Presigning credentials are Cloudflare Worker secrets, not committed values.
# Set using wrangler secret put <NAME> --config wrangler.local.toml.
# Local development: copy these names into gitignored .dev.vars with your values.
CF_ACCOUNT_ID=
R2_AK_id=
R2_SAK=

# R2 storage access uses env.DOCUMENT_BUCKET only.
# Configure [[r2_buckets]] binding = "DOCUMENT_BUCKET" in gitignored
# wrangler.local.toml with real bucket_name / preview_bucket_name.
# R2 bindings use bucket names, not a bucket ID. The committed config is a template.
