{
  "name": "collectrr-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "test:offline": "NO_EXTERNAL_NETWORK=true node --test tests/*.test.js",
    "db:init:local": "wrangler d1 execute lekho-db --local --file=src/db/schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply lekho-db --local"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
