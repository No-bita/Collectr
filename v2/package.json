{
  "name": "collectrr-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "test:offline": "NO_EXTERNAL_NETWORK=true node --test tests/*.test.js",
    "db:init:local": "npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:schema:generate": "node scripts/schema.js",
    "db:schema:check": "node scripts/schema.js --check",
    "test:fresh-db": "node scripts/test-fresh-db.js"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
