{
  "rules": [
    {
      "id": "UploadFromBrowser",
      "allowed": {
        "origins": [
          "https://collectrr-v2.collectr.workers.dev",
          "http://localhost:3000",
          "http://localhost:8788"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type"]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
